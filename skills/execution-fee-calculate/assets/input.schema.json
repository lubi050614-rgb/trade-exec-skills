{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "simulation_id": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "notional": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "cumulative_notional": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "charged_fee": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        }
      },
      "required": [
        "side",
        "notional"
      ],
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "account_id",
    "simulation_id",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
