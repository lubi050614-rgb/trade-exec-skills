{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "resources": {
              "type": "object",
              "properties": {
                "cash": {
                  "type": "string"
                },
                "margin": {
                  "type": "string"
                },
                "fee": {
                  "type": "string"
                },
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "lot_id": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "integer"
                      },
                      "bucket": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "lot_id",
                      "quantity"
                    ],
                    "additionalProperties": true
                  }
                },
                "account_version": {
                  "type": "integer"
                }
              },
              "required": [
                "cash",
                "margin",
                "fee",
                "claims",
                "account_version"
              ],
              "additionalProperties": true
            },
            "rule_version": {
              "type": "string"
            }
          },
          "required": [
            "valid",
            "resources",
            "rule_version"
          ],
          "additionalProperties": true
        },
        "warnings": {
          "type": "array"
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "data",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
