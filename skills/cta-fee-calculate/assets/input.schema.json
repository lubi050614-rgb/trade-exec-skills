{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "simulation_id": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_class": {
      "const": "FUTURES"
    },
    "data": {
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "trade_date": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "lots": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "enum": [
            "OPEN",
            "CLOSE",
            "CLOSE_TODAY",
            "CLOSE_YESTERDAY"
          ]
        }
      },
      "required": [
        "contract_id",
        "trade_date",
        "price",
        "lots",
        "offset"
      ],
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "simulation_id",
    "account_id",
    "asset_class",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
