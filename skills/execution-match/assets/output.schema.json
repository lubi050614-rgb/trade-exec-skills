{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "quantity": {
                  "type": "integer"
                },
                "price": {
                  "type": "string"
                },
                "expected_version": {
                  "type": "integer"
                },
                "event_id": {
                  "type": "string"
                },
                "model_version": {
                  "type": "string"
                }
              },
              "required": [
                "quantity",
                "price",
                "expected_version",
                "event_id",
                "model_version"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "quantity": {
                  "const": 0
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "quantity",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "data",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
