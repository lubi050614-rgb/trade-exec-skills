{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "simulation_id": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "order": {
          "type": "object",
          "properties": {
            "instrument_id": {
              "type": "string"
            },
            "side": {
              "enum": [
                "BUY",
                "SELL"
              ]
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "order_type": {
              "enum": [
                "LIMIT",
                "MARKET"
              ]
            },
            "limit_price": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "protection_price": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "time_in_force": {
              "const": "DAY"
            },
            "submitted_at": {
              "type": "string",
              "format": "date-time"
            },
            "target_id": {
              "type": "string"
            },
            "target_version": {
              "type": "integer",
              "minimum": 1
            },
            "account_version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "instrument_id",
            "side",
            "quantity",
            "order_type",
            "time_in_force",
            "submitted_at",
            "target_id",
            "target_version",
            "account_version"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "order_type": {
                    "const": "LIMIT"
                  }
                }
              },
              "then": {
                "required": [
                  "limit_price"
                ]
              },
              "else": {
                "required": [
                  "protection_price"
                ]
              }
            }
          ]
        },
        "client_order_id": {
          "type": "string"
        }
      },
      "required": [
        "order",
        "client_order_id"
      ],
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "account_id",
    "simulation_id",
    "data",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
