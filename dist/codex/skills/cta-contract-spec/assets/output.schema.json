              }
            },
            "previous_settlement": {
              "type": "object",
              "additionalProperties": {}
            },
            "disclaimer": {
              "type": "string"
            },
            "contract_id": {
              "type": "string"
            }
          },
          "required": [
            "profile_id",
            "version",
            "exchange",
            "product",
            "multiplier",
            "price_tick",
            "min_lots",
            "lot_step",
            "margin_mode",
            "margin",
            "fees",
            "close_priority",
            "separate_close",
            "lower_price",
            "upper_price",
            "trade_dates",
            "previous_settlement",
            "disclaimer",
            "contract_id"
