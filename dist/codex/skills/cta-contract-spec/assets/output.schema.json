            "exchange": {
              "type": "string"
            },
            "product": {
              "type": "string"
            },
            "multiplier": {
              "type": "integer"
            },
            "price_tick": {
              "type": "string"
            },
            "min_lots": {
              "type": "integer"
            },
            "lot_step": {
              "type": "integer"
            },
            "margin_mode": {
              "type": "string"
            },
            "margin": {
              "type": "object",
              "additionalProperties": {}
            },
            "fees": {
              "type": "object",
              "additionalProperties": {}
            },
            "close_priority": {
              "type": "array",
