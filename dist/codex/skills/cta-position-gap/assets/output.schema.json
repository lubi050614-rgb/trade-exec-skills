{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "actual_long_lots": {
              "type": "integer"
            },
            "actual_short_lots": {
              "type": "integer"
            },
            "actual_net_lots": {
              "type": "integer"
            },
            "pending_open_lots": {
              "type": "integer"
            },
            "pending_close_lots": {
              "type": "integer"
            },
            "gap_lots": {
              "type": "integer"
            },
            "conflicting_order_ids": {
              "type": "array",
              "items": {}
            },
            "retained_order_ids": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "actual_long_lots",
            "actual_short_lots",
            "actual_net_lots",
            "pending_open_lots",
            "pending_close_lots",
            "gap_lots",
            "conflicting_order_ids",
            "retained_order_ids"
          ],
          "additionalProperties": true
        },
        "warnings": {
          "type": "array"
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "data",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
