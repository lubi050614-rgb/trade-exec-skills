{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string"
            },
            "asset_class": {
              "type": "string"
            },
            "currency": {
              "type": "string"
            },
            "balance": {
              "type": "string"
            },
            "as_of": {
              "type": "string"
            },
            "version": {
              "type": "integer"
            },
            "equity": {
              "type": "string"
            },
            "floating_pnl": {
              "type": "string"
            },
            "position_margin": {
              "type": "string"
            },
            "frozen_cash": {
              "type": "string"
            },
            "available_cash": {
              "type": "string"
            },
            "margin_shortfall": {
              "type": "string"
            },
            "risk_status": {
              "type": "string"
            },
            "positions": {
              "type": "object",
              "additionalProperties": {}
            },
            "trade_date": {
              "type": "string"
            },
            "reconciliation_status": {
              "type": "string"
            }
          },
          "required": [
            "account_id",
            "asset_class",
            "currency",
            "balance",
            "as_of",
            "version",
            "equity",
            "floating_pnl",
            "position_margin",
            "frozen_cash",
            "available_cash",
            "margin_shortfall",
            "risk_status",
            "positions",
            "trade_date",
            "reconciliation_status"
          ],
          "additionalProperties": true
        },
        "warnings": {
          "type": "array"
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "data",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
