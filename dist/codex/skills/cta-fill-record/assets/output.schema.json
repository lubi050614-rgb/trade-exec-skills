{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "fill_id": {
              "type": "string"
            },
            "order_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "contract_id": {
              "type": "string"
            },
            "side": {
              "type": "string"
            },
            "offset": {
              "type": "string"
            },
            "lots": {
              "type": "integer"
            },
            "price": {
              "type": "string"
            },
            "notional": {
              "type": "string"
            },
            "fee": {
              "type": "string"
            },
            "reserved_consumption": {
              "type": "string"
            },
            "executed_at": {
              "type": "string"
            },
            "trade_date": {
              "type": "string"
            },
            "market_event_id": {
              "type": "string"
            },
            "model_version": {
              "type": "string"
            },
            "accounting_status": {
              "type": "string"
            },
            "order_applied": {
              "type": "boolean"
            },
            "realized_pnl": {
              "type": "string"
            },
            "source_hash": {
              "type": "string"
            }
          },
          "required": [
            "fill_id",
            "order_id",
            "contract_id",
            "side",
            "offset",
            "lots",
            "price",
            "notional",
            "fee",
            "reserved_consumption",
            "executed_at",
            "trade_date",
            "market_event_id",
            "model_version",
            "accounting_status",
            "order_applied",
            "realized_pnl",
            "source_hash"
          ],
          "additionalProperties": true
        },
        "warnings": {
          "type": "array"
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "data",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
