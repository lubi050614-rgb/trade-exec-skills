              "type": "string"
            },
            "order_type": {
              "type": "string"
            },
            "time_in_force": {
              "type": "string"
            },
            "target_id": {
              "type": "string"
            },
            "target_version": {
              "type": "integer"
            },
            "trade_date": {
              "type": "string"
