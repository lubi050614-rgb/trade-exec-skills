{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "roll_id": {
              "type": "string"
            },
            "old_plan_id": {
              "type": "string"
            },
            "new_plan_id": {
              "type": "string"
            },
            "lots": {
              "type": "integer"
            },
            "direction": {
              "type": "integer"
            },
            "hash": {
              "type": "string"
            },
            "commit_status": {
              "type": "string"
            }
          },
          "required": [
            "roll_id",
            "old_plan_id",
            "new_plan_id",
            "lots",
            "direction",
            "hash",
            "commit_status"
          ],
          "additionalProperties": true
        },
        "warnings": {
          "type": "array"
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "data",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok",
        "schema_version",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
