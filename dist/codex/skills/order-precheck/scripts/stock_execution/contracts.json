              "side",
              "quantity",
              "order_type",
              "time_in_force",
              "submitted_at",
              "target_id",
              "target_version",
              "account_version"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "order_type": {
                      "const": "LIMIT"
                    }
                  }
                },
                "then": {
                  "required": [
                    "limit_price"
                  ]
                },
                "else": {
                  "required": [
                    "protection_price"
